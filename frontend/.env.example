# Laravel API base URL (include /api/v1)
VITE_API_URL=http://localhost:8000/api/v1
# Map tiles. Default is OpenStreetMap (no key). Swap for a Google/Mapbox tile URL when keys are approved.
VITE_MAP_TILE_URL=https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png
VITE_MAP_ATTRIBUTION=&copy; OpenStreetMap contributors
# Default map centre (Hyderabad)
VITE_MAP_CENTER=17.4400,78.3800
